{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/webapp/index.html" },
    { "source": "/app", "destination": "/webapp/index.html" },
    { "source": "/webapp/(.*)", "destination": "/webapp/$1" },
    { "source": "/website/(.*)", "destination": "/website/$1" }
  ]
}
